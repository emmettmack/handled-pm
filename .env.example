# Copy this file to .env and fill in your key. .env is gitignored.
# The key is read ONLY by the backend (server/ai.js). It never reaches the browser.
#
# Leave it blank to run in demo (mock) mode: the app works with canned,
# rule-based responses and the UI shows a "Demo mode" label.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# PORT=3001
# DB_PATH=./data/handled.db
