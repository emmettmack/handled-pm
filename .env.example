# Copy this file to .env and fill in your key. .env is gitignored.
# The key is read ONLY by the backend (server/ai.js). It never reaches the browser.
#
# Leave it blank to run in demo (mock) mode: the app works with canned,
# rule-based responses and the UI shows a "Demo mode" label.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# PORT=3001
# DB_PATH=./data/handled.db

# Sign-in (Clerk). Leave blank for local development with no login.
# CLERK_SECRET_KEY=sk_...          (server only, never commit)
# VITE_CLERK_PUBLISHABLE_KEY=pk_... (public key, used when building the app)
# CLERK_AUTHORIZED_PARTIES=https://app.macalisto.com
# DATA_DIR=./data   (each signed-in account gets its own database file under DATA_DIR/accounts)
