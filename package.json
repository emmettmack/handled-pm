{
  "name": "handled-maintenance-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI maintenance coordination demo for residential landlords and property managers",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --watch-path=server server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "npm run build && node server/index.js",
    "seed": "node server/seed.js",
    "build:static": "vite build --config client/vite.static.config.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@clerk/backend": "^3.26.2",
    "@clerk/clerk-react": "^5.61.11",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "qrcode-generator": "^1.4.4",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  }
}
